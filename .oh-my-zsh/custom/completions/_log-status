#compdef log-status

# TODO: support level completions after specifying an option
# TODO: support option completions for --list-levels
if (( CURRENT == 2 )); then
  _arguments "1:log_level:($(log-status --list-levels))" --
elif [[ $words[2] == numbered ]] && (( CURRENT == 3 )); then
  _arguments '2:number:' --
else
  _arguments '*:message:' --
fi
