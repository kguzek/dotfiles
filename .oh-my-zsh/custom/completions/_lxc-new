#compdef lxc-new lxc-volume lxc-context lxc-remove

_lxc_defaults() {
  local defaults="${commands[lxc-new]:A:h}/.lxc-defaults"
  [[ -r "$defaults" ]] || return
  (
    source "$defaults"
    local setting
    for setting in "$@"; do
      if [[ "${(tP)setting}" == association* ]]; then
        print -l -- ${(kP)setting}
      else
        print -r -- "${(P)setting}"
      fi
    done
  )
}

_lxc_containers() {
  local -a containers skip=("$@")
  local id lxc_status name

  if (( ! $+commands[pct] )); then
    _message 'container name or ID'
    return
  fi

  pct list 2>/dev/null | awk 'NR > 1 { print $1, $2, $NF }' | while read -r id lxc_status name; do
    (( ${skip[(Ie)$id]} )) && continue
    containers+=("$name:$id, $lxc_status")
  done

  _describe 'container' containers
}

_lxc_volume_spec() {
  local colons="${PREFIX//[^:]/}"
  compset -P '*:'

  case $#colons in
    0)
      local -a pools=(${(f)"$(_lxc_defaults VOLUME_STORAGES)"})
      compadd -S ':' -q -- $pools
      ;;
    1)
      _message 'path inside the container, e.g. /data/NAME'
      ;;
    *)
      _message 'size in GB'
      compadd -- nobackup
      ;;
  esac
}

_lxc_removable_containers() {
  _lxc_containers ${(f)"$(_lxc_defaults TEMPLATE_ID DOCO_CD_ID)"}
}

case $service in
  lxc-new)
    _arguments '1:name:' '2:ID:' -- '*=POOL*:volume:_lxc_volume_spec' '*=*:value: '
    ;;
  lxc-volume)
    _arguments '1:container:_lxc_containers' '2:volume:_lxc_volume_spec' --
    ;;
  lxc-context)
    _arguments '1:container:_lxc_containers' --
    ;;
  lxc-remove)
    _arguments '1:container:_lxc_removable_containers' --
    ;;
esac
