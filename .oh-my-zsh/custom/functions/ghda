# vim: ft=zsh

# GitHub Dependabot approve
gh pr list --state open --app dependabot --json number,statusCheckRollup |
  jq '
    sort_by(.createdAt)
    | reverse
    | .[]
    | select(
      .statusCheckRollup
        | all(
          .status == "COMPLETED"
          and (.conclusion == "SUCCESS" or .conclusion == "NEUTRAL")
        )
      )
    | .number
  ' |
  xargs -L1 gh pr review --approve
