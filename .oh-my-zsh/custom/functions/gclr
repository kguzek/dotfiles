# vim: ft=zsh

# Git clone repository (shorthand)
if [ -z "$1" ]; then
  echo "Usage: $0 [AUTHOR/]REPO" >&2
  return 1
fi

local author='kguzek'
local repo="$1"
local host='ssh-git.guzek.uk'
shift

# If input contains a slash, assume it's author/repo and on GitHub
if [[ "$repo" == */* ]]; then
  author="${repo:h}"
  repo="${repo:t}"
  host='github.com'
fi

git clone "$@" "git@$host:$author/$repo.git" && cd "$repo"
