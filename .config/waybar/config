{
  "layer": "top",
  "position": "top",
  "height": 36,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["network", "tray"],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false
  },

  "clock": {
    "format": "{:%Y-%m-%d   %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀  Connected",
    "format-disconnected": "  Offline"
  },

  "tray": {
    "spacing": 15,
  }
}
