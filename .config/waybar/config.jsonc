{
  "layer": "top",
  "position": "top",
  "height": 40,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/kuma-pi",
    "custom/kuma-hp",
    "custom/kuma-wcss",
    "hyprland/language",
    "wireplumber#sink",
    "wireplumber#source",
    "battery",
    "bluetooth",
    "network",
    "custom/mako",
    "tray",
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{icon} {windows}",
    "format-window-separator": "",
    "workspace-taskbar": {
      "enable": true,
      "update-active-window": false,
      "format": "{icon}",
      "icon-size": 18,
      "on-click-window": "focus-window {address} {button}",
    },
  },

  "hyprland/window": {
    "separate-outputs": true,
  },

  "clock": {
    "format": "{:%Y-%m-%d   %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}",
  },

  "custom/kuma-pi": {
    "exec": "kuma-waybar --format=waybar --env=$HOME/.config/waybar/kuma-pi.env",
    "interval": 15,
    "on-click": "kuma-waybar open --env=$HOME/.config/waybar/kuma-pi.env",
    "format": "Pi {} ",
  },

  "custom/kuma-hp": {
    "exec": "kuma-waybar --format=waybar --env=$HOME/.config/waybar/kuma-hp.env",
    "interval": 15,
    "on-click": "kuma-waybar open --env=$HOME/.config/waybar/kuma-hp.env",
    "format": "HP {} ",
  },

  "custom/kuma-wcss": {
    "exec": "kuma-waybar --format=waybar --env=$HOME/.config/waybar/kuma-wcss.env",
    "interval": 15,
    "on-click": "kuma-waybar open --env=$HOME/.config/waybar/kuma-wcss.env",
    "format": "WCSS {} ",
  },

  "hyprland/language": {
    "format": "{short}",
    "on-click": "hyprctl switchxkblayout current next",
  },

  "wireplumber#sink": {
    "format": "{volume}% {icon}",
    "format-muted": "MUT ",
    "format-icons": ["", "", ""],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    // cycle-audio-device from https://github.com/kguzek/scripts
    "on-click-right": "cycle-audio-device --sink",
    "scroll-step": 1,
  },

  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "",
    "format-muted": "",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "cycle-audio-device --source",
    "scroll-step": 0,
  },

  "battery": {
    "bat": "BAT1",
    "interval": 60,
    "states": {
      "max": 100,
      "high": 80,
      "medium": 60,
      "low": 45,
      "warning": 30,
      "critical": 15,
    },
    "events": {
      "on-discharging-warning": "notify-send --expire-time 30000 --urgency normal 'Battery level low :(",
      "on-discharging-critical": "notify-send --urgency critical 'Battery level critical!'",
      "on-charging-max": "notify-send --expire-time 5000 --urgency low 'Battery is full :)'",
    },
    "format": "󱧥 {capacity}%",
    "format-full": "󱟢 {capacity}%",
    "format-discharging-max": "󰁹 {capacity}%",
    "format-discharging-high": "󱊣 {capacity}%",
    "format-discharging-medium": "󱊢 {capacity}%",
    "format-discharging-low": "󱊡 {capacity}%",
    "format-discharging-warning": "󰂎 {capacity}%",
    "format-discharging-critical": "󱃍 {capacity}%",
    "format-charging-max": "󰂅 {capacity}%",
    "format-charging-high": "󱊦 {capacity}%",
    "format-charging-medium": "󱊥 {capacity}%",
    "format-charging-low": "󱊤 {capacity}%",
    "format-charging-warning": "󰢟 {capacity}%",
    "format-charging-critical": "󰢟 {capacity}%",
    "max-length": 25,
  },

  "bluetooth": {
    "on-click": "bluetoothctl disconnect & rfkill toggle bluetooth",
    "format": "󰂳",
    "format-no-controller": "",
    "format-on": "",
    "format-off": "󰂱",
    "format-disabled": "󰂲",
    "format-connected": "󰂰",
    "tooltip-format": "Unknown state\n{controller_alias}\t{controller_address}",
    "tooltip-format-on": "Click to disable Bluetooth\nNo devices connected",
    "tooltip-format-off": "Bluetooth is powered off",
    "tooltip-format-disabled": "Click to enable Bluetooth",
    "tooltip-format-connected": "Click to disable Bluetooth\nConnected devices: {num_connections}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{icon} {device_battery_percentage}%",
    "format-icons": ["󰤾", "󰤿", "󰥀", "󰥂", "󰥁", "󰥃", "󰥄", "󰥅", "󰥆", "󰥈"],
  },

  "network": {
    "on-click": "rfkill toggle wlan",
    "format-wifi": "{icon}",
    "format-disabled": "󰖪",
    "format-ethernet": "󰈀",
    "format-disconnected": "",
    "tooltip-format-wifi": "Click to disable Wi-Fi\n\n  Signal strength: {signalStrength}%",
    "tooltip-format-disabled": "Click to enable Wi-Fi",
    "tooltip-format-ethernet": "Ethernet connected",
    "tooltip-format-disconnected": "Network disconnected",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
  },

  "custom/mako": {
    "exec": "if makoctl mode | grep -qx do-not-disturb; then printf '{\"text\":\"\",\"tooltip\":\"Click to disable do not disturb mode\\\\nRight-click to dismiss all notifications\"}\\n'; else printf '{\"text\":\"\",\"tooltip\":\"Click to enable do not disturb mode\\\\nRight-click to dismiss all notifications\"}\\n'; fi",
    "return-type": "json",
    "interval": 30,
    "on-click": "makoctl mode -t do-not-disturb",
    "on-click-right": "makoctl dismiss --all",
  },

  "tray": {
    "spacing": 15,
    "reverse-direction": true,
  },
}
