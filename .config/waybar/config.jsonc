{
  "layer": "top",
  "position": "top",
  "height": 40,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "hyprland/language",
    "wireplumber#sink",
    "wireplumber#source",
    "network",
    "tray",
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{icon} {windows}",
    "format-window-separator": "",
    "workspace-taskbar": {
      "enable": true,
      "update-active-window": false,
      "format": "{icon}",
      "icon-size": 18,
      "on-click-window": "focus-window {address} {button}",
    },
  },

  "hyprland/window": {
    "separate-outputs": true,
  },

  "clock": {
    "format": "{:%Y-%m-%d   %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}",
  },

  "hyprland/language": {
    "format": "{}",
    "format-pl": "PL",
    "format-en": "GB",
  },

  "wireplumber#sink": {
    "format": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": ["", "", ""],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    // cycle-audio-device from https://github.com/kguzek/scripts
    "on-click-right": "cycle-audio-device --sink",
    "scroll-step": 1,
  },

  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "{volume}% ",
    "format-muted": "",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "cycle-audio-device --source",
    "scroll-step": 1,
  },

  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "",
  },

  "tray": {
    "spacing": 15,
  },
}
