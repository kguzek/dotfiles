{
  "layer": "top",
  "position": "top",
  "height": 40,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/kuma-pi",
    "custom/kuma-hp",
    "custom/kuma-wcss",
    "hyprland/language",
    "wireplumber#sink",
    "wireplumber#source",
    "network",
    "custom/mako",
    "tray",
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{icon} {windows}",
    "format-window-separator": "",
    "workspace-taskbar": {
      "enable": true,
      "update-active-window": false,
      "format": "{icon}",
      "icon-size": 18,
      "on-click-window": "focus-window {address} {button}",
    },
  },

  "hyprland/window": {
    "separate-outputs": true,
  },

  "clock": {
    "format": "{:%Y-%m-%d   %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}",
  },

  "custom/kuma-pi": {
    "exec": "kuma-waybar --format=waybar --env=$HOME/.config/waybar/kuma-pi.env",
    "interval": 15,
    "on-click": "kuma-waybar open --env=$HOME/.config/waybar/kuma-pi.env",
    "format": "Pi {} ",
  },

  "custom/kuma-hp": {
    "exec": "kuma-waybar --format=waybar --env=$HOME/.config/waybar/kuma-hp.env",
    "interval": 15,
    "on-click": "kuma-waybar open --env=$HOME/.config/waybar/kuma-hp.env",
    "format": "HP {} ",
  },

  "custom/kuma-wcss": {
    "exec": "kuma-waybar --format=waybar --env=$HOME/.config/waybar/kuma-wcss.env",
    "interval": 15,
    "on-click": "kuma-waybar open --env=$HOME/.config/waybar/kuma-wcss.env",
    "format": "WCSS {} ",
  },

  "hyprland/language": {
    "format": "{short}",
    "on-click": "hyprctl switchxkblayout current next",
  },

  "wireplumber#sink": {
    "format": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": ["", "", ""],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    // cycle-audio-device from https://github.com/kguzek/scripts
    "on-click-right": "cycle-audio-device --sink",
    "scroll-step": 1,
  },

  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "{volume}% ",
    "format-muted": "",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "cycle-audio-device --source",
    "scroll-step": 1,
  },

  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "",
  },

  "custom/mako": {
    "exec": "if makoctl mode | grep -qx do-not-disturb; then printf '{\"alt\":\"activated\"}\\n'; else printf '{\"alt\":\"deactivated\"}\\n'; fi",
    "return-type": "json",
    "interval": 1,
    "on-click": "makoctl mode -t do-not-disturb",
    "format": "{icon}",
    "format-icons": {
      "activated": " ",
      "deactivated": " ",
    },
    "tooltip": true,
    "tooltip-format": "Toggle do not disturb mode for notifications",
  },

  "tray": {
    "spacing": 15,
  },
}
