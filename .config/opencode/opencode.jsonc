        },
        "qwen3:14b": {
          "name": "Qwen3 14B",
        },
        "ministral-3:3b": {
          "name": "Ministral 3 3B",
        },
        "ministral-3:8b": {
          "name": "Ministral 3 8B",
        },
        "ibm/granite4.1:8b": {
          "name": "Granite 4.1 8B",
        },
        "rnj-1:8b": {
