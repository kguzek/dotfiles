{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
    },
  },
  "plugin": ["@slkiser/opencode-quota"],
  "provider": {
    "openai": {},
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Solvro)",
      "options": {
        "baseURL": "https://ollama.b.solvro.pl/v1",
      },
      "models": {
        "gemma4:31b": {
          // DO NOT USE: not enough VRAM
          "name": "Gemma 4 31B",
        },
        "gemma4:e4b": {
          "name": "Gemma 4 e4B",
        },
        "qwen2.5-coder:14b": {
          "name": "Qwen2.5 Coder 14b",
        },
        "qwen3:14b": {
          "name": "Qwen3 14b",
        },
        "ministral-3:3b": {
          "name": "Ministral 3 3B",
        },
        "ministral-3:8b": {
          "name": "Ministral 3 8B",
        },
        "ibm/granite4.1:8b": {
          "name": "Granite 4.1 8B",
        },
        "rnj-1:8b": {
          "name": "Rnj-1 8B",
        },
        "deepseek-r1:1.5b": {
          "name": "DeepSeek R1 1.5b",
        },
        "deepseek-r1:7b": {
          "name": "DeepSeek R1 7b",
        },
        "deepseek-r1:8b": {
          "name": "DeepSeek R1 8b",
        },
        "deepseek-coder:1.3b": {
          "name": "DeepSeek Coder 1.3b",
        },
        "deepseek-coder:6.7b": {
          "name": "DeepSeek Coder 6.7b",
        },
      },
    },
  },
}
